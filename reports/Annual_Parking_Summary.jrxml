                <expression><![CDATA[$F{parkingLotName}]]></expression>
            </element>

            <element kind="textField"
                     uuid="751939cc-15b8-4842-9b0a-7a537c4d1ef7"
                     x="220" y="0" width="45" height="18">
                <expression><![CDATA[$F{parkingLotId}]]></expression>
            </element>

            <element kind="textField"
                     uuid="ddadd27e-a77c-4267-9a3b-07ca914d8d98"
                     x="265" y="0" width="120" height="18">
                <expression><![CDATA[$F{parkingLotCity}]]></expression>
            </element>

            <element kind="textField"
                     uuid="c5355eb8-f858-4f61-ad24-b4fa514d3115"
                     x="385" y="0" width="100" height="18"
                     pattern="#,##0.00">
                <expression><![CDATA[$F{totalAmountPaid}]]></expression>
            </element>

            <element kind="textField"
                     uuid="3ca0663a-e43e-4e93-9645-864cb781d000"
                     x="485" y="0" width="70" height="18">
                <expression><![CDATA[$F{otherColorVehicleCount}]]></expression>
            </element>
        </band>
