<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3 -->

<jasperReport name="AnnualSummaryReport" language="java"
              pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="11111111-2222-3333-4444-555555555555">

    <!-- Data Adapter -->
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="ParkWiseAccessDB"/>

    <!-- Parameter -->
    <parameter name="EnterYear" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[2025]]></defaultValueExpression>
    </parameter>

    <!-- SQL QUERY -->
    <query language="sql"><![CDATA[
SELECT
    ParkingLot.ID              AS parkingLotId,
    ParkingLot.name            AS parkingLotName,
    City.cityName              AS parkingLotCity,

    Nz(
        Sum(
            IIf(
                Receipt.paymentDate IS NOT NULL
                AND Year(Receipt.paymentDate) = $P{EnterYear},
                Receipt.finalAmount,
                0
            )
        ),
        0
    ) AS totalAmountPaid,

    Nz(
        Sum(
            IIf(
                ParkingSession.startTime IS NOT NULL
                AND Year(ParkingSession.startTime) = $P{EnterYear}
                AND Vehicle.color = "other",
                1,
                0
            )
        ),
        0
    ) AS otherColorVehicleCount

FROM
    (City INNER JOIN ParkingLot
        ON City.ID = ParkingLot.cityID)

    LEFT JOIN
    (
        (ParkingSession
            LEFT JOIN Vehicle
                ON ParkingSession.vehicleID = Vehicle.ID)
        LEFT JOIN Receipt
            ON ParkingSession.ID = Receipt.parkingSessionID
    )
        ON ParkingLot.ID = ParkingSession.parkingLotID

GROUP BY
    ParkingLot.ID,
    ParkingLot.name,
    City.cityName

ORDER BY
    City.cityName DESC,
    totalAmountPaid ASC;
]]></query>

    <!-- Fields -->
    <field name="parkingLotId" class="java.lang.Integer"/>
    <field name="parkingLotName" class="java.lang.String"/>
    <field name="parkingLotCity" class="java.lang.String"/>
    <field name="totalAmountPaid" class="java.math.BigDecimal"/>
    <field name="otherColorVehicleCount" class="java.lang.Integer"/>

    <!-- ===== TITLE ===== -->
    <title height="50">
        <element kind="staticText"
