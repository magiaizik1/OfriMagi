                 fontSize="16.0" bold="true" hTextAlign="Center">
            <text><![CDATA[Annual Parking Summary]]></text>
        </element>

        <element kind="textField"
                 uuid="1d8c4c7f-5d40-423d-a418-185b26b5a61b"
                 x="0" y="28" width="555" height="18"
                 hTextAlign="Center">
            <expression><![CDATA["Year: " + $P{EnterYear}]]></expression>
        </element>
    </title>

